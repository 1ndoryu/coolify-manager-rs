{
  "schemaVersion": 2,
  "mode": "enforce",
  "project": {
    "primaryBranch": "main"
  },
  "guard": {
    "directCommands": {
      "npmScripts": ["lint", "test", "build", "check"],
      "npxTools": ["eslint", "tsc", "typescript"],
      "cargoSubcommands": ["check", "test", "clippy", "fmt"],
      "tools": ["git"]
    }
  },
  "analyzers": {
    "sentinel": {
      "enabled": true,
      "profile": "mixed",
      "config": {
        "includePatterns": [
          "**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.css",
          "**/*.rs", "Cargo.toml", "Cargo.lock", "**/*.py"
        ],
        "excludePatterns": [
          "**/node_modules/**", "**/dist/**", "**/build/**", "**/target/**",
          "**/__pycache__/**", "**/.venv/**", "**/.git/**"
        ],
        "directoryExceptions": ["commands", "services", "infra", "componentes"],
        "portableBoundaries": {
          "window": [
            "gui/src/componentes/ui/MenuContextual.tsx",
            "gui/src/componentes/ui/Modal.tsx",
            "gui/src/componentes/ui/SelectorPersonalizado.tsx"
          ],
          "dom": [
            "gui/src/componentes/ui/MenuContextual.tsx",
            "gui/src/componentes/ui/Modal.tsx",
            "gui/src/componentes/VistaPortal.tsx",
            "gui/src/main.tsx"
          ]
        },
        "rules": {},
        "runtime": {
          "minimumVersion": "",
          "protocolVersion": 0,
          "lockFile": ""
        }
      }
    }
  }
}
